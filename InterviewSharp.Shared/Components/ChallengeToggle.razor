@inject IJSRuntime JS

<div class="form-check form-switch mb-2" title="Hide topic names so you have to decide which technique to use">
    <input class="form-check-input" type="checkbox" role="switch" id="challenge-@Id" checked="@Value" @onchange="Changed" />
    <label class="form-check-label small" for="challenge-@Id">Challenge mode (hide topics)</label>
</div>

@code {
    private const string StorageKey = "interviewsharp.challenge";

    [Parameter] public bool Value { get; set; } = true;
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }
    [Parameter] public string Id { get; set; } = "main";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
            if (saved is not null && bool.TryParse(saved, out var v) && v != Value)
                await ValueChanged.InvokeAsync(v);
        }
        catch { }
    }

    private async Task Changed(ChangeEventArgs e)
    {
        var v = e.Value is bool b && b;
        try { await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, v.ToString()); }
        catch { }
        await ValueChanged.InvokeAsync(v);
    }
}
