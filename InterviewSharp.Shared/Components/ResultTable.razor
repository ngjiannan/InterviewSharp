@using InterviewSharp.Services

@if (Result is null)
{
}
else if (Result.Error is not null)
{
    <div class="alert alert-danger mb-0" style="white-space:pre-wrap">@Result.Error</div>
}
else
{
    <div class="small text-muted mb-1">
        @Result.Rows.Count row(s)@(Result.Truncated ? " (truncated to first 500)" : "") &middot; @Result.ElapsedMs ms
    </div>
    <div class="result-wrap">
        <table class="table table-sm table-striped table-bordered mb-0">
            <thead class="table-dark">
                <tr>@foreach (var c in Result.Columns) {<th>@c</th>}</tr>
            </thead>
            <tbody>
                @foreach (var row in Result.Rows)
                {
                    <tr>
                        @foreach (var v in row)
                        {
                            @if (v is null) { <td class="text-muted fst-italic">NULL</td> }
                            else { <td>@Format(v)</td> }
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public QueryResult? Result { get; set; }

    private static string Format(object v) => v switch
    {
        DateTime d when d.TimeOfDay == TimeSpan.Zero => d.ToString("yyyy-MM-dd"),
        DateTime d => d.ToString("yyyy-MM-dd HH:mm:ss"),
        _ => Convert.ToString(v, System.Globalization.CultureInfo.InvariantCulture) ?? ""
    };
}
