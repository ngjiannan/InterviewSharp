<Router AppAssembly="typeof(App).Assembly" AdditionalAssemblies="new[] { typeof(InterviewSharp.Shared.Pages.Marker).Assembly }" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(InterviewSharp.Shared.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
