<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <RootNamespace>InterviewSharp.Pwa</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <ProjectReference Include="..\InterviewSharp.Shared\InterviewSharp.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!-- Single source of truth: the question JSON files in the repo root are copied into wwwroot/data. -->
  <Target Name="CopyContentData" BeforeTargets="BeforeBuild;ResolveStaticWebAssetsInputs">
    <ItemGroup>
      <ContentData Include="..\questions.json;..\mcq_angular.json;..\mcq_dotnet.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ContentData)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot\data" SkipUnchangedFiles="true" />
  </Target>

</Project>
